<Window x:Class="DispensingMachine.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:conv="clr-namespace:DispensingMachine.App.Converters"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="点胶机上位机控制系统"
        Height="820" Width="1320"
        MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Background="#16161C"
        FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <conv:MmToCanvasLeftConverter x:Key="MmToLeft" MaxMillimeters="500" />
        <conv:BoolToBrushConverter x:Key="BoolToBrush" />
        <conv:StateToBrushConverter x:Key="StateToBrush" />
        <conv:AlarmLevelToBrushConverter x:Key="LevelToBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 卡片容器 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#22222B" />
            <Setter Property="BorderBrush" Value="#33333F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7E7E92" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8EA0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EDEDF5" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

        <Style x:Key="BigValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EDEDF5" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="Light" />
        </Style>

        <!-- 深色下拉框：WPF 默认模板用系统白底，浅色文字会看不见，必须自己写模板 -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EDEDF5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#2A2A34" BorderBrush="#3E3E4C"
                                                BorderThickness="1" CornerRadius="5">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  Data="M0,0 L4,4 L8,0" Stroke="#8E8EA0" StrokeThickness="1.5" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="10,7,26,7"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade">
                                <Border Background="#2A2A34" BorderBrush="#3E3E4C" BorderThickness="1"
                                        CornerRadius="5" Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#DCDCE8" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3C3C4C" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 操作按钮 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2E2E3A" />
            <Setter Property="Foreground" Value="#DCDCE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3E3E4C" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3C3C4C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A5C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2E7D32" />
            <Setter Property="BorderBrush" Value="#3E9142" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#B71C1C" />
            <Setter Property="BorderBrush" Value="#D32F2F" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部状态栏 ==================== -->
        <Border Grid.Row="0" Background="#1E1E26" BorderBrush="#2E2E3A" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="点胶机上位机控制系统" Foreground="#EDEDF5" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="  ·  DISPENSING-01" Foreground="#6E6E82" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 当前状态 -->
                    <Border Background="{Binding Controller.State, Converter={StaticResource StateToBrush}}"
                            CornerRadius="4" Padding="12,5" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Controller.StateText}" Foreground="#FFFFFF"
                                   FontSize="13" FontWeight="SemiBold" />
                    </Border>

                    <!-- 当前模式 -->
                    <Border Background="#2C2C38" CornerRadius="4" Padding="12,5" Margin="0,0,10,0">
                        <TextBlock Foreground="#B9B9CC" FontSize="13">
                            <Run Text="模式 " />
                            <Run Text="{Binding Controller.ModeText, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>

                    <!-- 当前工步 -->
                    <Border Background="#2C2C38" CornerRadius="4" Padding="12,5">
                        <TextBlock Foreground="#B9B9CC" FontSize="13">
                            <Run Text="工步 " />
                            <Run Text="{Binding Controller.Step, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" · " />
                            <Run Text="{Binding Controller.StepText, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding PlcStatusText}" Foreground="#7E7E92" FontSize="11"
                                   HorizontalAlignment="Right" />
                        <TextBlock Foreground="#5E5E72" FontSize="11" HorizontalAlignment="Right">
                            <Run Text="心跳 " />
                            <Run Text="{Binding PlcHeartbeatText, Mode=OneWay}" FontFamily="Consolas" />
                        </TextBlock>
                    </StackPanel>
                    <Button Content="急 停" Style="{StaticResource DangerButton}"
                            Command="{Binding EmergencyStopCommand}" Padding="26,9" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体三栏 ==================== -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- ========== 左栏：设备状态 ========== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>

                    <!-- X 轴 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="X 轴伺服" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="{Binding Axis.Model.CurrentPosition, StringFormat={}{0:F2} mm}"
                                       Style="{StaticResource BigValue}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="状态" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding Axis.StateText}" Style="{StaticResource Value}" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="到位" Style="{StaticResource Label}" />
                                    <TextBlock Text="{Binding Axis.Model.InPosition}" FontSize="13"
                                               FontFamily="Consolas"
                                               Foreground="{Binding Axis.Model.InPosition, Converter={StaticResource BoolToBrush}, ConverterParameter=#4CAF50|#EF5350}" />
                                </StackPanel>
                            </Grid>

                            <!-- 位置可视化轨道 -->
                            <Canvas Height="74" Margin="0,12,0,0" ClipToBounds="False">
                                <Rectangle Canvas.Left="0" Canvas.Top="38" Width="250" Height="5"
                                           Fill="#3A3A48" RadiusX="2" RadiusY="2" />

                                <!-- 三个工艺位置的刻度 -->
                                <Rectangle Canvas.Left="0" Canvas.Top="31" Width="2" Height="19" Fill="#42A5F5" />
                                <Rectangle Canvas.Left="25" Canvas.Top="31" Width="2" Height="19" Fill="#7E7E92" />
                                <Rectangle Canvas.Left="60" Canvas.Top="31" Width="2" Height="19" Fill="#7E7E92" />

                                <!-- 当前位置滑块 -->
                                <Ellipse Width="16" Height="16" Canvas.Top="32" Fill="#FFB300">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="-8" />
                                    </Ellipse.RenderTransform>
                                    <Canvas.Left>
                                        <Binding Path="Axis.Model.CurrentPosition"
                                                 Converter="{StaticResource MmToLeft}"
                                                 ConverterParameter="250" />
                                    </Canvas.Left>
                                </Ellipse>
                            </Canvas>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="等待位" Style="{StaticResource Label}" FontSize="10" />
                                <TextBlock Text="   扫码位" Style="{StaticResource Label}" FontSize="10" />
                                <TextBlock Text="   点胶位" Style="{StaticResource Label}" FontSize="10" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 气缸 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="夹紧气缸" Style="{StaticResource SectionTitle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#2A2A34" CornerRadius="5" Padding="10,8" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="缩回到位" Style="{StaticResource Label}" FontSize="11" />
                                        <Ellipse Width="12" Height="12" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                 Fill="{Binding Cylinder.Model.RetractedSensor, Converter={StaticResource BoolToBrush}, ConverterParameter=#4CAF50|#3A3A48}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#2A2A34" CornerRadius="5" Padding="10,8" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="伸出到位" Style="{StaticResource Label}" FontSize="11" />
                                        <Ellipse Width="12" Height="12" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                 Fill="{Binding Cylinder.Model.ExtendedSensor, Converter={StaticResource BoolToBrush}, ConverterParameter=#4CAF50|#3A3A48}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding Cylinder.StateText}" Style="{StaticResource Value}"
                                       FontSize="13" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 扫码枪 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="扫码枪" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Scanner.LastBarcode, TargetNullValue=—, FallbackValue=—}"
                                       Style="{StaticResource Value}" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,6,0,0">
                                <Run Text="本次条码 " />
                                <Run Text="{Binding Controller.CurrentBarcode, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 配方 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="工艺配方" Style="{StaticResource SectionTitle}" />

                            <ComboBox Style="{StaticResource DarkCombo}"
                                      ItemsSource="{Binding Recipes}"
                                      SelectedValuePath="RecipeName"
                                      SelectedValue="{Binding SelectedRecipeName, Mode=TwoWay}">
                                <!-- 自定义 ControlTemplate 后 DisplayMemberPath 不再自动生成模板，
                                     必须显式给 ItemTemplate，否则选中项会显示成类型全名 -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RecipeName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <Button Content="载入配方" Style="{StaticResource ActionButton}"
                                        Command="{Binding LoadRecipeCommand}" Margin="0,0,4,0" Padding="10,7" />
                                <Button Content="保存参数" Style="{StaticResource ActionButton}"
                                        Command="{Binding ApplyRecipeCommand}" Margin="4,0,0,0" Padding="10,7" />
                            </UniformGrid>

                            <Separator Background="#33333F" Margin="0,12,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="扫码位" Style="{StaticResource Label}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Value}" FontSize="12"
                                           Text="{Binding CurrentRecipe.ScanPosition, StringFormat={}{0:F1} mm}" />
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="点胶位" Style="{StaticResource Label}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Value}" FontSize="12"
                                           Text="{Binding CurrentRecipe.WorkPosition, StringFormat={}{0:F1} mm}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ========== 中栏：工位全景 + 日志 ========== -->
            <Grid Grid.Column="1" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 工步进度 -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="工步进度" Style="{StaticResource SectionTitle}" />
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource Label}">
                                <Run Text="{Binding Controller.Step, Mode=OneWay}" />
                                <Run Text=" / 80" />
                            </TextBlock>
                        </Grid>

                        <ProgressBar Height="8" Minimum="0" Maximum="80"
                                     Value="{Binding Controller.Step, Mode=OneWay}"
                                     Background="#2A2A34" Foreground="#42A5F5" BorderThickness="0" />

                        <TextBlock Text="{Binding StatusMessage}" Foreground="#B9B9CC" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,12,0,0" />

                        <Border Background="#2A2A34" CornerRadius="5" Padding="12,10" Margin="0,10,0,0"
                                Visibility="{Binding Controller.LastDiagnosis, Converter={StaticResource NullToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="专家诊断" Foreground="#FFB300" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Controller.LastDiagnosis.FaultSymptom}"
                                           Foreground="#EDEDF5" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Controller.LastDiagnosis.RootCause}"
                                           Foreground="#B9B9CC" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Controller.LastDiagnosis.MaintenanceAdvice}"
                                           Foreground="#8E8EA0" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 运行日志 -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="运行日志" Style="{StaticResource SectionTitle}" />
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource Label}">
                                <Run Text="累计产能 " />
                                <Run Text="{Binding Controller.ProducedCount, Mode=OneWay}" FontWeight="Bold" Foreground="#4CAF50" />
                                <Run Text=" PCS" />
                            </TextBlock>
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Background="Transparent"
                                 BorderThickness="0" Foreground="#9A9AAE" FontSize="12"
                                 FontFamily="Consolas" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,2" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========== 右栏：报警 + 通讯 ========== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 当前报警 -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="当前报警" Style="{StaticResource SectionTitle}" />

                        <Border Background="#2A2A34" CornerRadius="5" Padding="12"
                                Visibility="{Binding Controller.CurrentAlarm, Converter={StaticResource NullToVisibility}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{Binding Controller.CurrentAlarm.Level, Converter={StaticResource LevelToBrush}}"
                                            CornerRadius="3" Padding="7,2">
                                        <TextBlock Text="{Binding Controller.CurrentAlarm.Level}" Foreground="#FFFFFF" FontSize="10" />
                                    </Border>
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"
                                               Foreground="#EDEDF5" FontSize="13">
                                        <Run Text="ERR-" />
                                        <Run Text="{Binding Controller.CurrentAlarm.Code, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Text="{Binding Controller.CurrentAlarm.Message}"
                                           Foreground="#DCDCE8" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding Controller.CurrentAlarm.Source}"
                                           Foreground="#7E7E92" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="暂无报警，设备运行正常" Foreground="#4CAF50" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Controller.HasAlarm}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Content="清除报警 / 复位" Style="{StaticResource ActionButton}"
                                Command="{Binding ResetCommand}" Margin="0,10,0,0" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <!-- 报警历史 -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="报警历史" Style="{StaticResource SectionTitle}" />

                        <ListBox Grid.Row="1" ItemsSource="{Binding AlarmHistory}" Background="Transparent"
                                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#26262F" CornerRadius="4" Padding="10,7" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{Binding Level, Converter={StaticResource LevelToBrush}}"
                                                    CornerRadius="2" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Display}" Foreground="#C9C9DA"
                                                           FontSize="11" TextWrapping="Wrap" FontFamily="Consolas" />
                                                <TextBlock Text="{Binding DurationText}" Foreground="#6E6E82"
                                                           FontSize="10" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== 底部操作栏 ==================== -->
        <Border Grid.Row="2" Background="#1E1E26" BorderBrush="#2E2E3A" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="启动自动" Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartCommand}" />
                    <Button Content="暂停" Style="{StaticResource ActionButton}"
                            Command="{Binding PauseCommand}" />
                    <Button Content="继续" Style="{StaticResource ActionButton}"
                            Command="{Binding ResumeCommand}" />
                    <Button Content="停止" Style="{StaticResource ActionButton}"
                            Command="{Binding StopCommand}" />
                    <Button Content="下一步（调试）" Style="{StaticResource ActionButton}"
                            Command="{Binding NextStepCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="手动：" Foreground="#6E6E82" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="使能+回零" Style="{StaticResource ActionButton}"
                            Command="{Binding HomeCommand}" Padding="12,7" />
                    <Button Content="走到扫码位" Style="{StaticResource ActionButton}"
                            Command="{Binding MoveToScanCommand}" Padding="12,7" />
                    <Button Content="夹紧" Style="{StaticResource ActionButton}"
                            Command="{Binding ClampCommand}" Padding="12,7" />
                    <Button Content="松开" Style="{StaticResource ActionButton}"
                            Command="{Binding UnclampCommand}" Padding="12,7" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PlcSnapshotText}" Foreground="#5E5E72" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,14,0" FontFamily="Consolas" />
                    <Button Content="连接 PLC" Style="{StaticResource ActionButton}"
                            Command="{Binding ConnectPlcCommand}" Padding="12,7" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
